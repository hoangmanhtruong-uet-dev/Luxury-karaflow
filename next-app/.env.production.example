# ============================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env.production and fill in real values.
# NEVER commit .env.production or real secrets to Git.
# ============================================================

# --- Database (required) ---
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full

# CA certificate for TLS verification (pick ONE method)
# Method 1: Base64-encoded CA cert
DATABASE_SSL_CA_BASE64=
# Method 2: PEM-encoded CA cert (inline)
DATABASE_SSL_CA_PEM=
# Method 3: Path to CA cert file on disk
DATABASE_SSL_CA_FILE=

# MUST be "false" or unset in production. "true" will fail verification.
DATABASE_SSL_ALLOW_UNVERIFIED=false

# --- Authentication & Security Secrets (required) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECURITY_EVENT_HASH_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RECOVERY_CODE_HASH_SECRET=
# TOTP encryption key: MUST be 32 bytes, base64-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# --- Cron Jobs (required if using HTTP cron) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# --- Canonical Origin & Proxy (required) ---
# Your canonical HTTPS origin (no trailing slash)
PRODUCTION_CANONICAL_ORIGIN=https://your-domain.com
# Must match PRODUCTION_CANONICAL_ORIGIN
AUTH_URL=https://your-domain.com
# Must be "true" when behind a proxy (Render, Vercel, Cloudflare)
AUTH_TRUST_HOST=true
# Proxy mode: "cloudflare" | "vercel" | "single"
TRUSTED_PROXY_MODE=vercel
# Must match TRUSTED_PROXY_MODE
PRODUCTION_EXPECTED_PROXY_MODE=vercel

# --- Public Brand/Contact (required) ---
# Must be HTTPS and match PRODUCTION_CANONICAL_ORIGIN
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_HOTLINE=0901234567
NEXT_PUBLIC_BRAND_NAME=Your Brand
NEXT_PUBLIC_SITE_DESCRIPTION=Your site description
NEXT_PUBLIC_SITE_SHORT_DESCRIPTION=Short description
NEXT_PUBLIC_SITE_TAGLINE=Your tagline
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com
NEXT_PUBLIC_CONTACT_ADDRESS=Your address
NEXT_PUBLIC_OG_IMAGE=/images/og-image.jpg
NEXT_PUBLIC_ZALO_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_BRANCH_SUMMARY=
NEXT_PUBLIC_OPENING_HOURS=09:00 - 06:00

# --- Notification Provider (required for email alerts) ---
# Options: "disabled" | "console" | "webhook"
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# --- Payment (optional; leave empty to disable) ---
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- Media Storage (required for admin media) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=admin-media

# --- Test Database (DO NOT SET IN PRODUCTION) ---
# TEST_DATABASE_URL=
# PRODUCTION_DATABASE_HOSTS=
# ALLOW_REMOTE_TEST_DATABASE=false

# --- Bootstrap (MUST be unset in steady-state production) ---
# ALLOW_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
